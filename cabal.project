packages:
    haskell-src/chainweb-data.cabal
with-compiler: ghc-9.12.2
index-state: 2026-02-01T00:00:00Z

source-repository-package
    type: git
    location: https://github.com/vootaa/chainweb-api.git
    tag: 1b2de025cfdc09698bfb1ec3807cd85405d6a339
    --sha256: sha256-06jvD1kmkmthcRkyWhVLTbytwabghInxqXQD/Lm7kbA=

package vault
    documentation: false

write-ghc-environment-files: never

constraints: http2 <4.2
constraints: cabal-doctest ==1.0.12

allow-newer: beam-migrate:pqueue
allow-newer: beam-migrate:aeson
allow-newer: beam-migrate:deepseq
allow-newer: beam-core:aeson
allow-newer: beam-postgres:deepseq
allow-newer: streaming-events:*
allow-newer: postgresql-simple-migration:*
allow-newer: beam-postgres:*
allow-newer: *:vector
allow-newer: *:base
allow-newer: vector:base
allow-newer: vector-stream:ghc-prim
allow-newer: *:template-haskell
allow-newer: *:ghc-prim
allow-newer: *:text
allow-newer: cabal-doctest:Cabal
allow-newer: *:Cabal
allow-newer: *:cabal-doctest
allow-newer: servant-swagger-ui:bytestring
allow-newer: servant-swagger-ui:text
allow-newer: servant-swagger-ui-core:text
allow-newer: hashable:bytestring
allow-newer: hashable:containers
allow-newer: *:bytestring
allow-newer: *:containers
